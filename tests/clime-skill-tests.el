(ert-deftest clime-test-skill/render-root-args ()
  "Root (app-level) positional arguments are rendered."
  (let* ((app (clime-app rooted-cli
                :help "Root with a positional"
                (clime-arg target :required t :help "The target")
                (clime-handler (ctx) (ignore ctx) "")))
         (m (clime-skill-manifest app :command "rooted"))
         (out (clime-skill-render m)))
    (should (string-match-p "<target>" out))))

(ert-deftest clime-test-skill/render-group-scope-ordering ()
  "Usage documents option scope: root global, subcommand options follow."
  (clime-skill-test--with-fixture app
    (let* ((m (clime-skill-manifest app :command "demo"))
           (out (clime-skill-render m)))
      ;; root/global options are documented as global until `--'
      (should (string-match-p "global" out))
      ;; and the per-node scope rule is stated
      (should (string-match-p "belong to" out)))))

;;; ─── Blocker 3: rollback-safe forced replacement ───────────────────────

(ert-deftest clime-test-skill/write-force-rollback-preserves-old ()
  "A rename failure mid-force-replace restores the previous skill."
  (clime-skill-test--with-fixture app
    (clime-test-with-temp-dir
      (let* ((dir (expand-file-name "out" temp-dir))
             (m (clime-skill-manifest app :command "demo")))
        ;; install v1, then plant a marker that must survive a failed replace
        (clime-skill-write m :target 'portable :output dir)
        (write-region "OLD-CONTENT" nil (expand-file-name "marker" dir))
        ;; fail the *install* rename (2nd rename), not the move-aside (1st)
        (let* ((orig (symbol-function 'rename-file))
               (n 0))
          (cl-letf (((symbol-function 'rename-file)
                     (lambda (a b &optional ok-if-exists)
                       (cl-incf n)
                       (if (= n 2)
                           (error "boom during install")
                         (funcall orig a b ok-if-exists)))))
            (should-error
             (clime-skill-write m :target 'portable :output dir :force t))))
        ;; the previous skill (and its marker) must be intact — not lost
        (should (file-directory-p dir))
        (should (file-exists-p (expand-file-name "marker" dir)))
        (should (equal "OLD-CONTENT"
                       (with-temp-buffer
                         (insert-file-contents (expand-file-name "marker" dir))
                         (buffer-string))))
        ;; no backup/temp scaffolding left behind
        (should-not (cl-find-if
                     (lambda (f) (string-prefix-p "clime-skill" f))
                     (directory-files temp-dir)))))))

;;; ─── Blocker 4: safe command spelling ──────────────────────────────────

(ert-deftest clime-test-skill/command-spelling-rejects-metacharacters ()
  "Shell/Markdown metacharacters in a command spelling are rejected."
  (clime-skill-test--with-fixture app
    (dolist (bad '("demo; rm -rf /"
                   "demo`whoami`"
                   "demo$(id)"
                   "demo && echo x"
                   "demo | tee out"
                   "demo > /etc/passwd"
                   "demo\nrm"
                   "de mo"
                   "$(evil)"
                   "demo\"x"
                   "-rf"))
      (should-error (clime-skill-manifest app :command bad)
                    :type 'clime-usage-error))))

(ert-deftest clime-test-skill/command-spelling-accepts-safe-tokens ()
  "Plain executable tokens (incl. path forms) are accepted verbatim."
  (clime-skill-test--with-fixture app
    (dolist (ok '("demo" "clime-make" "bin/clime" "./clime"
                  "/usr/bin/clime" "demo.el" "demo_v2"))
      (let ((m (clime-skill-manifest app :command ok)))
        (should (equal (plist-get m :command) ok))))))

;;; ─── nav-contract REFINE findings (2026-08-28) ─────────────────────────

;; Finding 1 — Agent Skills name/directory conformance for portable output.

(ert-deftest clime-test-skill/write-portable-name-matches-directory ()
  "Portable output: rendered `name' equals the destination dir basename.
The app is named demo-cli but is written to a `my-skill' directory; the
spec requires name to match the directory, so it must be `my-skill'."
  (clime-skill-test--with-fixture app
    (clime-test-with-temp-dir
      (let* ((dir (expand-file-name "my-skill" temp-dir))
             (m (clime-skill-manifest app :command "demo")))
        (should (equal (plist-get m :name) "demo-cli")) ; premise: differs
        (clime-skill-write m :target 'portable :output dir)
        (let ((fm (with-temp-buffer
                    (insert-file-contents (expand-file-name "SKILL.md" dir))
                    (clime-skill-test--parse-frontmatter (buffer-string)))))
          (should (equal (cdr (assoc "name" fm)) "my-skill"))
          (should-not (equal (cdr (assoc "name" fm)) "demo-cli")))))))

(ert-deftest clime-test-skill/write-portable-rejects-nonconformant-dir ()
  "A portable output whose basename is not a valid skill name errors.
Prevents emitting a `name' that cannot equal a non-conformant directory."
  (clime-skill-test--with-fixture app
    (clime-test-with-temp-dir
      (let ((m (clime-skill-manifest app :command "demo")))
        (dolist (bad '("Bad_Name" "UPPER" "has space" "trailing-"))
          (should-error
           (clime-skill-write m :target 'portable
                              :output (expand-file-name bad temp-dir))
           :type 'clime-usage-error))))))

(ert-deftest clime-test-skill/write-codex-name-matches-directory ()
  "Codex/Claude: rendered `name' equals the skills/NAME dir basename.
Regression guard — these layouts build the directory from the name, so
they already agree; assert it explicitly."
  (clime-skill-test--with-fixture app
    (clime-test-with-temp-dir
      (let ((m (clime-skill-manifest app :command "demo")))
        (clime-skill-write m :target 'codex :output temp-dir)
        (let ((fm (with-temp-buffer
                    (insert-file-contents
                     (expand-file-name ".agents/skills/demo-cli/SKILL.md"
