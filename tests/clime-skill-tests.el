(ert-deftest clime-test-skill/render-fixed-nargs-arg ()
  "A fixed nargs=N positional renders N distinct placeholders."
  ;; Hand-built manifest exercises arg-level fixed nargs directly.
  (let* ((manifest
          (list :name "demo" :command "demo" :version nil :description "D"
                :root (list :kind 'app :name "demo" :path nil :help nil
                            :arguments nil :options nil
                            :commands
                            (list (list :kind 'command :name "move"
                                        :path '("move") :help "Move"
                                        :options nil
                                        :arguments
                                        (list (list :name "coords" :required t
                                                    :nargs 2)))))))
         (out (clime-skill-render manifest)))
    (should (string-match-p "<coords> <coords>" out))))

