;; Finding 2 — exact :multiple space-separated grammar.

(ert-deftest clime-test-skill/render-multiple-space-separated ()
  "A :multiple option documents both repeated and space-separated values.
Clime accepts `--tag a b c' where unambiguous, not just repetition."
  (clime-skill-test--with-fixture app
    (let* ((m (clime-skill-manifest app :command "demo"))
           (out (clime-skill-render m)))
      ;; grammar must name the space-separated form, not only 'repeatable'
      (should (string-match-p "space-separated" out))
      (should (string-match-p "a b c" out)))))

;; Finding 3 — forced replacement preserves the backup when the restore
;; rename ALSO fails (double failure), rather than deleting it.

(ert-deftest clime-test-skill/write-force-rollback-double-failure-preserves-backup ()
  "When BOTH install and restore renames fail, the old skill survives.
The previous bytes must remain recoverable in a preserved backup, never
deleted by cleanup."
  (clime-skill-test--with-fixture app
    (clime-test-with-temp-dir
      (let* ((dir (expand-file-name "out" temp-dir))
             (m (clime-skill-manifest app :command "demo")))
        (clime-skill-write m :target 'portable :output dir)
        (write-region "OLD-CONTENT" nil (expand-file-name "marker" dir))
        ;; move-aside (rename #1) succeeds; install (#2) and restore (#3) fail
        (let* ((orig (symbol-function 'rename-file))
               (n 0))
          (cl-letf (((symbol-function 'rename-file)
                     (lambda (a b &optional ok-if-exists)
                       (cl-incf n)
                       (if (>= n 2)
                           (error "boom rename %d" n)
                         (funcall orig a b ok-if-exists)))))
            (should-error
             (clime-skill-write m :target 'portable :output dir :force t))))
        ;; the old marker bytes must survive in a preserved backup directory
        (let ((survivor
               (cl-find-if
                (lambda (d)
                  (and (file-directory-p d)
                       (let ((mk (expand-file-name "marker" d)))
                         (and (file-exists-p mk)
                              (equal "OLD-CONTENT"
                                     (with-temp-buffer
                                       (insert-file-contents mk)
                                       (buffer-string)))))))
                (directory-files temp-dir t "clime-skill-bak"))))
          (should survivor))))))

;;; ─── Integration via `clime-make skill' ────────────────────────────────

(defconst clime-skill-test--app-source "\
(require 'clime)
(defvar demo-integ--choices-called nil)
(defun demo-integ--secret-default () \"SENTINEL-SECRET-DO-NOT-LEAK-9f3a2b7c\")
(defun demo-integ--secret-choices ()
  (setq demo-integ--choices-called t)
  (list \"SENTINEL-SECRET-DO-NOT-LEAK-9f3a2b7c\" \"safe\"))
(clime-app demo-cli
  :version \"1.2.3\"
  :env-prefix \"DEMO\"
  :help \"Demo CLI for skill export tests.\"
  (clime-opt token (\"--token\") :env t :help \"API token\")
  (clime-command greet
    :help \"Greet someone\"
    (clime-arg name :help \"Who\" :choices '(\"alice\" \"bob\"))
    (clime-opt shout (\"--shout\" \"-s\") :bool :help \"Uppercase\")
    (clime-handler (ctx) (ignore ctx) \"\"))
  (clime-group db
    :help \"Database ops\"
    (clime-command migrate
      :help \"Run migrations\"
      (clime-arg steps :type 'integer :required nil :default 1 :help \"Steps\")
      (clime-opt secret (\"--secret\") :default #'demo-integ--secret-default
        :help \"Secret\")
      (clime-opt mode (\"--mode\") :choices #'demo-integ--secret-choices
        :help \"Mode\")
      (clime-handler (ctx) (ignore ctx) \"\"))))
(provide 'demo-cli)
"
  "Self-contained fixture app source written to a temp file.")

(defun clime-skill-test--run-make (&rest argv)
  "Run the clime-make app with ARGV, returning the exit code.
Output is captured so the batch test stays quiet."
  (let ((exit nil))
    (with-temp-buffer
      (let ((standard-output (current-buffer)))
        (setq exit (clime-run clime-make argv))))
    exit))

(defmacro clime-skill-test--with-app-file (file &rest body)
  "Write the fixture source to FILE inside a temp dir for BODY."
  (declare (indent 1) (debug t))
  `(clime-test-with-temp-dir
     (let ((,file (expand-file-name "demo-cli.el" temp-dir))
           (process-environment
            (cons (concat "DEMO_TOKEN=" clime-skill-test--secret)
                  process-environment)))
       (with-temp-file ,file
         (insert clime-skill-test--app-source))
       ,@body)))

(ert-deftest clime-test-skill/cli-portable ()
  "`clime-make skill FILE --command C --output DIR' builds a skill dir."
  (clime-skill-test--with-app-file file
    (let* ((out (expand-file-name "gen" temp-dir))
           (code (clime-skill-test--run-make
                  "skill" file "--command" "demo" "--output" out)))
      (should (= code 0))
      (should (file-exists-p (expand-file-name "SKILL.md" out)))
      (with-temp-buffer
        (insert-file-contents (expand-file-name "SKILL.md" out))
        (should (clime-skill-test--parse-frontmatter (buffer-string)))
        (should-not (string-match-p clime-skill-test--secret
                                    (buffer-string)))))))

(ert-deftest clime-test-skill/cli-codex ()
  "`--target codex' installs under .agents/skills/NAME/."
  (clime-skill-test--with-app-file file
    (let ((code (clime-skill-test--run-make
                 "skill" file "--command" "demo"
                 "--target" "codex" "--output" temp-dir)))
      (should (= code 0))
      (should (file-exists-p
               (expand-file-name ".agents/skills/demo-cli/SKILL.md" temp-dir))))))

(ert-deftest clime-test-skill/cli-claude ()
