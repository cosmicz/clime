               (expand-file-name ".claude/skills/demo-cli/SKILL.md" temp-dir))))))

(ert-deftest clime-test-skill/cli-app-override ()
  "`--app' selects the app symbol, matching serve's loader contract."
  (clime-skill-test--with-app-file file
    (let ((code (clime-skill-test--run-make
                 "skill" file "--app" "demo-cli" "--command" "demo"
                 "--output" (expand-file-name "gen" temp-dir))))
      (should (= code 0))
      (should (file-exists-p
               (expand-file-name "gen/SKILL.md" temp-dir))))))

(ert-deftest clime-test-skill/cli-force ()
  "Regeneration onto an existing dir needs --force."
  (clime-skill-test--with-app-file file
    (let ((out (expand-file-name "gen" temp-dir)))
      (should (= 0 (clime-skill-test--run-make
                    "skill" file "--command" "demo" "--output" out)))
      ;; second run without --force fails (non-zero exit)
      (should-not (= 0 (clime-skill-test--run-make
                        "skill" file "--command" "demo" "--output" out)))
      ;; with --force it succeeds
      (should (= 0 (clime-skill-test--run-make
                    "skill" file "--command" "demo" "--output" out
                    "--force"))))))

(ert-deftest clime-test-skill/cli-secret-absent-all-files ()
  "No GENERATED file contains the sentinel secret.
Scans only the generated skill tree — the input source file legitimately
contains the sentinel and is not a generated artifact."
  (clime-skill-test--with-app-file file
    (should (= 0 (clime-skill-test--run-make
                  "skill" file "--command" "demo"
                  "--target" "claude" "--output" temp-dir)))
    ;; the dynamic :choices function must never have been invoked
    (should (null (bound-and-true-p demo-integ--choices-called)))
    (let* ((skills (expand-file-name ".claude/skills/demo-cli" temp-dir))
           (files (directory-files-recursively skills ".*")))
      (should files)
      (dolist (f files)
        (with-temp-buffer
          (insert-file-contents f)
          (should-not (string-match-p clime-skill-test--secret
                                      (buffer-string))))))))

